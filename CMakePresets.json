{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "arm-base",
      "hidden": true,
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/cmake/toolchains/clang-arm-none-eabi.cmake"
    },
    {
      "name": "debug",
      "displayName": "Debug (arm-none-eabi)",
      "inherits": "arm-base",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release (arm-none-eabi)",
      "inherits": "arm-base",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      }
    },
    {
      "name": "simulator",
      "displayName": "PC Simulator (host clang)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/simulator",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "SIMULATOR": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "jobs": 0
    },
    {
      "name": "release",
      "configurePreset": "release",
      "jobs": 0
    },
    {
      "name": "simulator",
      "configurePreset": "simulator",
      "jobs": 0
    }
  ],
  "workflowPresets": [
    {
      "name": "debug",
      "displayName": "Debug (configure + build)",
      "steps": [
        { "type": "configure", "name": "debug" },
        { "type": "build", "name": "debug" }
      ]
    },
    {
      "name": "release",
      "displayName": "Release (configure + build)",
      "steps": [
        { "type": "configure", "name": "release" },
        { "type": "build", "name": "release" }
      ]
    }
  ],
  "workflowPresets": [
    {
      "name": "debug",
      "displayName": "Debug (configure + build)",
      "steps": [
        { "type": "configure", "name": "debug" },
        { "type": "build",     "name": "debug" }
      ]
    },
    {
      "name": "release",
      "displayName": "Release (configure + build)",
      "steps": [
        { "type": "configure", "name": "release" },
        { "type": "build",     "name": "release" }
      ]
    },
    {
      "name": "simulator",
      "displayName": "Simulator (configure + build)",
      "steps": [
        { "type": "configure", "name": "simulator" },
        { "type": "build",     "name": "simulator" }
      ]
    }
  ]
}
